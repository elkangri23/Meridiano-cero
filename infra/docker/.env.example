# Configuración de entorno para Meridiano Cero
# Copia este archivo a .env y ajusta los valores según tu entorno.

# Base de datos PostgreSQL
POSTGRES_PASSWORD=meridiano_dev

# API
PORT=3000
DATABASE_URL=postgresql://meridiano:meridiano_dev@localhost:5432/meridiano
NODE_ENV=development

# IA (Ollama local o endpoint compatible)
# Para desarrollo local con Docker Desktop: host.docker.internal
# Para Linux nativo: usa la IP del host o 172.17.0.1
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Web (Vite dev server)
VITE_API_URL=http://localhost:3000

# Seguridad (generar con: openssl rand -hex 32)
SESSION_SECRET=cambiar_en_produccion
CSRF_SECRET=cambiar_en_produccion