# Meridiano-cero — variables para infra/docker/docker-compose.yml
# Uso: cp infra/docker/.env.example .env  (desde la raíz del repo)
# Solo para la vía de contenedores completos de infra/docker; el desarrollo
# local habitual usa el README de la raíz (compose.yaml + host).

# Contraseña de PostgreSQL (usuario `meridiano`, base `meridiano`).
# La DATABASE_URL de la API la construye el compose a partir de esta variable.
POSTGRES_PASSWORD=meridiano_dev

# IA local (Ollama en el host). En Linux nativo `host.docker.internal` no
# existe: usa la IP del host Docker (habitualmente 172.17.0.1) o
# --add-host=host.docker.internal:host-gateway.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
