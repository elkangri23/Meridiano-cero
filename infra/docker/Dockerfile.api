# Dockerfile para API (Fastify + TypeScript + pnpm) - Multi-stage with direct copy
FROM node:24-alpine AS base
RUN corepack enable pnpm && apk add --no-cache python3 make g++ tar
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/ai-adapters/package.json ./packages/ai-adapters/
COPY packages/case-schema/package.json ./packages/case-schema/
COPY packages/engine/package.json ./packages/engine/
COPY packages/generator/package.json ./packages/generator/
COPY packages/contracts/package.json ./packages/contracts/

RUN pnpm install --frozen-lockfile --prod

FROM base AS builder
COPY --from=base /app/node_modules ./node_modules
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @meridiano/case-schema build
RUN pnpm --filter @meridiano/engine build
RUN pnpm --filter @meridiano/ai-adapters build
RUN pnpm --filter @meridiano/generator build
RUN pnpm --filter @meridiano/contracts build
RUN pnpm --filter @meridiano/api build
RUN cp packages/case-schema/package.json packages/case-schema/dist/ && \
    cp packages/engine/package.json packages/engine/dist/ && \
    cp packages/ai-adapters/package.json packages/ai-adapters/dist/ && \
    cp packages/generator/package.json packages/generator/dist/ && \
    cp packages/contracts/package.json packages/contracts/dist/

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/node_modules ./node_modules
# Direct copy of packages directory from builder
COPY --from=builder /app/packages ./packages
WORKDIR /app
EXPOSE 3000
CMD ["node", "apps/api/dist/server.js"]