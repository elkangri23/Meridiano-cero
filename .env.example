# Plantilla; pnpm setup:local genera .env y secretos únicos sin sobrescribir.
APP_MODE=development
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:5173
LOCAL_DEV_AUTH_ENABLED=true
REGISTRATION_ENABLED=false
# Obligatorio: no hay credenciales compartidas por defecto.
DATABASE_URL=
DATABASE_MIGRATION_URL=
PG_HOST_PORT=15432
DB_ADMIN_SECRET_FILE=./.local-secrets/admin-password
DB_APP_SECRET_FILE=./.local-secrets/app-password
