{
  "route": "freellmapi",
  "common": "COMUN.md",
  "paths_deny": [
    "**/.env*", "**/*credentials*", "**/*.pem", "**/*.key",
    ".git/**", ".harness/**", "harness.yaml", "AGENTS.md", "CLAUDE.md",
    "docs/agents/**", "docs/meridi/**", "docs/quality/ACEPTACION.md", "docs/quality/FASE-0.md",
    "scripts/harness/**", "scripts/harness.ps1"
  ],
  "roles": {
    "planner": {
      "title": "Arquitecto conversacional", "profile": "planner.md", "mode": "readonly",
      "paths_allow": []
    },
    "motor": {
      "title": "Motor y expedientes", "profile": "motor.md", "mode": "write",
      "paths_allow": [
        "packages/engine/**", "packages/case-schema/**", "tests/engine/**", "docs/engine/**",
        "docs/specs/SPEC-001-motor.md", "docs/specs/SPEC-002-expediente.md",
        "docs/specs/SPEC-003-caso-fijo.md", "docs/specs/SPEC-008-carrera.md"
      ]
    },
    "backend": {
      "title": "API y persistencia", "profile": "backend.md", "mode": "write",
      "paths_allow": [
        "apps/api/**", "packages/contracts/**", "tests/api/**", "docs/backend/**",
        "docs/specs/SPEC-004-api.md", "docs/specs/SPEC-010-publico.md", "docs/specs/SPEC-011-seguridad.md"
      ]
    },
    "frontend": {
      "title": "Experiencia e interfaz", "profile": "frontend.md", "mode": "write",
      "paths_allow": ["apps/web/**", "packages/ui/**", "tests/web/**", "docs/frontend/**", "docs/specs/SPEC-006-interfaz.md"]
    },
    "ia": {
      "title": "IA, fidelidad y generación", "profile": "ia.md", "mode": "write",
      "paths_allow": [
        "packages/ai-adapters/**", "packages/case-generator/**", "apps/worker/**",
        "tests/ai/**", "tests/generation/**", "docs/ai/**",
        "docs/specs/SPEC-005-ia.md", "docs/specs/SPEC-007-generacion.md"
      ]
    },
    "qa": {
      "title": "Calidad y aceptación", "profile": "qa.md", "mode": "write",
      "paths_allow": [
        "tests/e2e/**", "tests/integration/**", "tests/security/**", "tests/accessibility/**",
        "tests/fixtures/**", "tests/helpers/**", "docs/quality/**", "docs/manuales/PRUEBAS.md"
      ]
    },
    "ops": {
      "title": "Infraestructura y reproducibilidad", "profile": "ops.md", "mode": "write",
      "paths_allow": [
        "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig*.json",
        "eslint.config.*", ".prettierrc*", "prettier.config.*", ".prettierignore",
        "vitest.config.*", "playwright.config.*", ".npmrc", ".nvmrc", ".node-version",
        ".editorconfig", ".gitignore", "Dockerfile", ".dockerignore", "compose*.yml",
        "compose*.yaml", "docker-compose*.yml", "docker-compose*.yaml", "infra/**",
        "scripts/dev/**", "scripts/ci/**", "scripts/db/**", "scripts/backup/**",
        ".github/workflows/**", "docs/operations/**",
        "docs/manuales/DESARROLLO.md", "docs/manuales/INSTALACION.md", "docs/manuales/OPERACION.md",
        "docs/specs/SPEC-009-operacion.md", "docs/specs/SPEC-012-programacion.md"
      ]
    },
    "seguridad": {
      "title": "Seguridad y privacidad", "profile": "seguridad.md", "mode": "readonly",
      "paths_allow": [], "independent_of": ["motor", "backend", "frontend", "ia", "qa", "ops"]
    },
    "reviewer": {
      "title": "Revisión de entrega", "profile": "reviewer.md", "mode": "readonly",
      "paths_allow": [], "independent_of": ["motor", "backend", "frontend", "ia", "qa", "ops"]
    }
  }
}
