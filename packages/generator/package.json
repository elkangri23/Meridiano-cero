{
  "name": "@meridiano/generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.ts",
      "import": "./dist/checkpoint.js"
    },
    "./validator": {
      "types": "./dist/validator.d.ts",
      "import": "./dist/validator.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@meridiano/case-schema": "workspace:*",
    "@meridiano/contracts": "workspace:*",
    "@meridiano/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vitest": "5.0.5"
  }
}