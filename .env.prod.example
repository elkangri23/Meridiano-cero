# Plantilla del entorno de producción (Fase B). Copiar a `.env.prod` en el
# VPS (nunca en git) y rellenar las contraseñas generadas para
# `.secrets/prod-admin-password` y `.secrets/prod-app-password`.
# El correo (RESEND_API_KEY y MAIL_FROM) es OPCIONAL: sin él el registro y
# la recuperación funcionan, pero la verificación de email queda pendiente
# (la API registra EMAIL_NOT_CONFIGURED). No reutilizar la clave de Resend
# de retaton: pertenece a otro proyecto.

# API como rol de aplicación (permisos mínimos)
DATABASE_URL=postgresql://meridiano_app:CAMBIAR_APP_PASSWORD@db:5432/meridiano
# Migraciones como rol propietario
DATABASE_MIGRATION_URL=postgresql://meridiano_owner:CAMBIAR_ADMIN_PASSWORD@db:5432/meridiano

# Correo para verificación de email y recuperación (opcional, pendiente)
# RESEND_API_KEY=
# MAIL_FROM=Meridiano-cero <noreply@laurafernandezenfermeria.com>
